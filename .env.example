# InvestPal ecosystem configuration.
#
# `make setup` copies this to .env and fills it in. Every value here already
# works, so you can also just copy it and change nothing:
#
#     cp .env.example .env
#
# Credentials do NOT live in this file. They go in .env.secrets, which the
# Claude Code agent is denied read access to. See .env.secrets.example.
#
# This file is the single source of configuration for all five services.
# scripts/lib.sh fans it out into each service's process environment at start
# time, so you never edit a .env inside a service repo — and re-cloning a
# service repo cannot lose your settings.

# ── Worth setting ────────────────────────────────────────────────────────────

# SEC EDGAR asks automated clients to identify themselves with a contact
# address, and returns 403 to a User-Agent that has none or that contains a URL.
SEC_EDGAR_USER_AGENT="InvestPal/1.0 (you@example.com)"

# ── Ports ────────────────────────────────────────────────────────────────────
# The MCP ports must agree with the URLs in .mcp.json; `make doctor` cross-checks
# those. Ports that are not MCP servers are called out below.

MARKET_DATA_PORT=8082      # the Go server defaults to 8080; start.sh gates 8082
INVESTPAL_API_PORT=8000
INVESTPAL_MCP_PORT=9000
COINBASE_MCP_PORT=9090
ALPACA_MCP_PORT=9091
IB_MCP_PORT=9092
IB_GATEWAY_PORT=5000       # Interactive Brokers' own Java gateway
INVESTPAL_WEB_PORT=5173    # local web UI (`make ui`); not MCP, not in .mcp.json

# ── Backend agent (optional) ─────────────────────────────────────────────────
# These configure InvestPal's OWN agent: the /chat REST endpoint, the local web
# UI (`make ui`), and workflows executed by the backend rather than by the cockpit.
#
# The Claude Code cockpit does not use any of it — there, Claude Code is the
# LLM. Leave the API keys in .env.secrets blank and everything still works.
#
# Do not blank these two: InvestPal/config.py gives them no defaults, so an
# empty value stops both InvestPal processes from starting at all.
LLM_PROVIDER=anthropic     # anthropic | openai | google
LLM_MODEL=claude-sonnet-4-6

# Per-agent overrides. Each provider named here needs its key in .env.secrets.
# INVESTMENT_MANAGER_LLM_PROVIDER=anthropic
# INVESTMENT_MANAGER_LLM_MODEL=claude-sonnet-4-6
# USER_CONTEXT_MEMORY_MANAGER_LLM_PROVIDER=anthropic
# USER_CONTEXT_MEMORY_MANAGER_LLM_MODEL=claude-haiku-4-5
# WORKFLOW_EXECUTION_AGENT_LLM_PROVIDER=anthropic
# WORKFLOW_EXECUTION_AGENT_LLM_MODEL=claude-sonnet-4-6
# TEMPERATURE=0.1
# CONVERSATION_MESSAGES_LIMIT=15

# ── InvestPal storage ────────────────────────────────────────────────────────

# Local turso/SQLite file, relative to the InvestPal directory. The REST API and
# the MCP app share it and must agree on the path. Created on first start.
TURSO_DB_PATH=investpal.db

# Optional Turso Cloud sync. Nothing syncs automatically — see
# InvestPal/docs/turso_sync.md and `make turso_status`. With this set, both
# InvestPal processes refuse to start until the local database has been
# initialised with `make turso_first_push` or `make turso_first_pull`.
TURSO_SYNC_URL=
# The auth token lives in .env.secrets.
TURSO_SYNC_CLIENT_NAME=    # must differ per device; defaults to investpal-<hostname>

# Semantic search over conversation notes, via a ~67MB ONNX model downloaded
# once and cached locally. Set false and notes still write and list, but
# searchUserConversationNotes returns nothing.
EMBEDDING_ENABLED=true
# EMBEDDING_CACHE_DIR=~/.cache/investpal/fastembed

# Give InvestPal's backend agent the broker tools too. Off by default: the
# cockpit reaches the broker MCP servers directly through .mcp.json, so this is
# only needed for the REST API and the web UI.
CONNECT_BROKERS_TO_BACKEND=false

# ── Brokerages ───────────────────────────────────────────────────────────────
# All optional. The keys themselves live in .env.secrets; these only shape
# behaviour. READ_ONLY=true hides the order-placing tools from the advisor.

# Defaults to Alpaca's PAPER endpoint. Live trading needs an explicit override.
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_READ_ONLY=false

COINBASE_READ_ONLY=false

# Interactive Brokers needs no API keys: it authenticates through the IB Client
# Portal Gateway, which you start and log into in a browser.
IB_READ_ONLY=false
# IB_PORTAL_BASE_URL=https://localhost:5000/v1/api

# ── Market data ──────────────────────────────────────────────────────────────
# The data sources are keyless. A CoinGecko key only raises its rate limits,
# and because it is a credential it belongs in .env.secrets.

# CACHE_TTL=3600
